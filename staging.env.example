COMPOSE_PROJECT_NAME=qingshu-staging
QINGSHU_HTTP_BIND=127.0.0.1
QINGSHU_HTTP_PORT=18000

# Replace before use. Never commit the populated staging environment file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
QINGSHU_ADMIN_API_TOKEN=replace-with-a-different-random-token

BACKGROUND_JOBS_ENABLED=true
BACKGROUND_WORKER_MODE=external
JOB_WORKER_CONCURRENCY=1
JOB_WORKER_HEARTBEAT_SECONDS=10
JOB_WORKER_STALE_SECONDS=45
QINGSHU_DB_POOL_MAX_SIZE=6
QINGSHU_OPERATIONAL_DB_POOL_MAX_SIZE=3

QINGSHU_BACKUP_INTERVAL_SECONDS=86400
QINGSHU_BACKUP_RETENTION_DAYS=7
QINGSHU_BACKUP_MINIMUM_RETAINED=3
QINGSHU_BACKUP_MAX_AGE_SECONDS=93600

# Keep paid/external providers disabled for the first infrastructure smoke.
HERMES_ENABLED=false
BACKGROUND_USE_HERMES=false
TUSHARE_ENABLED=false
TUSHARE_TOKEN=
