# Local storage. Relative paths are resolved from the project directory.
QINGSHU_DATA_DIR=./data
QINGSHU_HTTP_BIND=0.0.0.0
QINGSHU_HTTP_PORT=8000
# Web、金融领域数据和持久化任务统一使用 PostgreSQL；未配置时拒绝启动。
QINGSHU_DATABASE_URL=postgresql://qingshu:change-me@127.0.0.1:5432/qingshu
QINGSHU_DB_POOL_MIN_SIZE=1
QINGSHU_DB_POOL_MAX_SIZE=8
QINGSHU_OPERATIONAL_DB_POOL_MIN_SIZE=1
QINGSHU_OPERATIONAL_DB_POOL_MAX_SIZE=4

# Hermes is opt-in so the API and tests work without spending model tokens.
HERMES_ENABLED=false
HERMES_BIN=hermes
# Optional: only needed when the Hermes virtual-environment Python cannot be detected.
HERMES_PYTHON_BIN=
HERMES_TIMEOUT_SECONDS=120
SEC_USER_AGENT=QingshuFinancialResearch/0.1 your-email@example.com
SESSION_TTL_DAYS=365
# Production HTTPS deployment should set this to true.
SESSION_COOKIE_SECURE=false
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
MAX_DOCUMENT_UPLOAD_BYTES=20971520

# Text conversations use DeepSeek by default. These values can be overridden.
HERMES_ECONOMY_PROVIDER=deepseek
HERMES_ECONOMY_MODEL=deepseek-v4-pro
HERMES_ECONOMY_MAX_TOKENS=
HERMES_ECONOMY_MAX_ITERATIONS=4
HERMES_ECONOMY_REASONING_EFFORT=
# The deep tier currently uses the same reliable text model; it differs in the
# research workflow and evidence budget rather than using an unverified model.
HERMES_DEEP_PROVIDER=deepseek
HERMES_DEEP_MODEL=deepseek-v4-pro
HERMES_DEEP_MAX_TOKENS=2200
HERMES_DEEP_MAX_ITERATIONS=6
HERMES_DEEP_REASONING_EFFORT=medium
# Vision stays explicit because deepseek-v4-pro is not a multimodal model.
HERMES_VISION_PROVIDER=
HERMES_VISION_MODEL=

# Public-data cache targets for the demo.
MARKET_CACHE_SECONDS=300
SECTOR_CACHE_SECONDS=60
INTRADAY_CACHE_SECONDS=20
ARTICLE_MIN_INTERVAL_HOURS=4
ARTICLE_MAX_PER_24H=3
BACKGROUND_JOBS_ENABLED=true
# embedded: Web process also runs workers (local default)
# external: Web only exposes APIs; run `uv run qingshu-worker` separately
# disabled: register no active schedules and run no worker
BACKGROUND_WORKER_MODE=embedded
JOB_WORKER_CONCURRENCY=2
JOB_QUEUE_POLL_SECONDS=1
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=10
JOB_RETRY_MAX_SECONDS=600
JOB_WORKER_HEARTBEAT_SECONDS=10
JOB_WORKER_STALE_SECONDS=45
JOB_SUCCEEDED_RETENTION_HOURS=168
JOB_FAILED_RETENTION_HOURS=720
JOB_CANCELLED_RETENTION_HOURS=168
BACKGROUND_RUN_COMPLETED_RETENTION_HOURS=720
BACKGROUND_RUN_FAILED_RETENTION_HOURS=2160
DATA_HEALTH_RETENTION_HOURS=720
# Compose runs one immediate PostgreSQL backup and then repeats daily.
QINGSHU_BACKUP_DIR=./backups
QINGSHU_BACKUP_INTERVAL_SECONDS=86400
QINGSHU_BACKUP_RETENTION_DAYS=14
QINGSHU_BACKUP_MINIMUM_RETAINED=7
QINGSHU_BACKUP_MAX_AGE_SECONDS=93600
BACKGROUND_MARKET_REFRESH_SECONDS=30
BACKGROUND_ARTICLE_CHECK_SECONDS=1800
BACKGROUND_INFO_REFRESH_SECONDS=600
BACKGROUND_FUNDAMENTALS_REFRESH_SECONDS=3600
BACKGROUND_FUND_PRODUCT_REFRESH_SECONDS=1800
BACKGROUND_RESEARCH_REFRESH_SECONDS=1800
BACKGROUND_CALIBRATION_REFRESH_SECONDS=21600
BACKGROUND_DATA_QUALITY_SECONDS=60
BACKGROUND_USE_HERMES=false
DEFAULT_A_SHARE_SYMBOLS=000063.SZ,300308.SZ
DEFAULT_RESEARCH_SYMBOLS=000063.SZ,300308.SZ,300750.SZ,NVDA
DEFAULT_FUND_PRODUCT_CODES=510300,510500,159915,110022,000011,000198
PUBLISH_WITH_HERMES=false
PUBLISH_MODEL_TIER=economy

# API keys are intentionally absent. Configure credentials in Hermes or the
# process environment; never commit them to this project.

# Tushare Pro-compatible proxy. Filling the local token enables it automatically.
# TUSHARE_ENABLED=true
TUSHARE_TOKEN=
TUSHARE_API_URL=https://teajoin.com
LI_ZONG_UNIVERSE_BATCH_SIZE=10
LI_ZONG_REFRESH_SECONDS=30

# Required only for internal/manual data refresh endpoints. Use a long random value.
QINGSHU_ADMIN_API_TOKEN=
TUSHARE_TIMEOUT_SECONDS=20
