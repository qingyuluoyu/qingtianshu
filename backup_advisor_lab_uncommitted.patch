+def test_yahoo_provider_uses_query2_when_query1_times_out(tmp_path: Path):
+    del tmp_path
+
+    class CacheDatabase:
+        def __init__(self) -> None:
+            self.cache = {}
+
+        def get_cache(self, key, allow_stale=False):
+            del allow_stale
+            return self.cache.get(key)
+
+        def put_cache(self, key, value, ttl_seconds):
+            del ttl_seconds
+            self.cache[key] = value
+
+        def delete_market_bars(self, *args):
+            del args
+
+        def upsert_market_bars(self, *args):
+            del args
+
+        def get_market_bars(self, *args, **kwargs):
+            del args, kwargs
+            return []
+
+    database = CacheDatabase()
+    calls = []
+    payload = {
+        "chart": {
+            "result": [
+                {
+                    "meta": {"currency": "USD"},
+                    "timestamp": [1_700_000_000],
+                    "indicators": {"quote": [{"close": [10.0]}]},
+                }
+            ]
+        }
+    }
+
+    def http_get(url, **kwargs):
+        calls.append((url, kwargs))
+        if "query1" in url:
+            raise TimeoutError("query1 timed out")
+        return FakeResponse(payload)
+
+    provider = YahooMarketProvider(database, http_get=http_get)
+
+    history = provider.fetch_history("AAPL", range_name="1mo")
+
+    assert len(calls) == 2
+    assert "query1.finance.yahoo.com" in calls[0][0]
+    assert "query2.finance.yahoo.com" in calls[1][0]
+    assert history["points"][-1]["close"] == 10.0
+    assert history["source_url"].startswith("https://query2.finance.yahoo.com")
+
+
