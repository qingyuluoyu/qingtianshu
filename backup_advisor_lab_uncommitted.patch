+def _scoped_stock_preview(evidence: dict[str, Any]) -> str:
+    """Render a bounded, user-facing stock answer from selected evidence only."""
+
+    plan = evidence.get("research_plan") or {}
+    selected = [str(item) for item in plan.get("selected_topics") or plan.get("selected_modules") or []][:4]
+    statuses = evidence.get("module_statuses") or {}
+    metrics = evidence.get("metrics") or {}
+    name = str(evidence.get("display_name") or evidence.get("symbol") or "该股票")
+    labels = plan.get("module_labels") or {}
+    focus = str(plan.get("focus") or "")
+    market_parts = []
+    if metrics.get("latest_close") is not None:
+        market_parts.append(f"最近收盘价 {fmt(metrics.get('latest_close'))}")
+    if metrics.get("return_20d_pct") is not None:
+        market_parts.append(f"近20日涨跌 {fmt(metrics.get('return_20d_pct'))}%")
+    if metrics.get("return_60d_pct") is not None:
+        market_parts.append(f"近60日涨跌 {fmt(metrics.get('return_60d_pct'))}%")
+    market_fact = "；".join(market_parts) or "行情字段尚未形成可核验结论"
+    available = [
+        topic
+        for topic in selected
+        if str((statuses.get(topic) or {}).get("status") or "").lower()
+        in {"fresh", "reused", "available", "partial"}
+    ]
+    unavailable = [topic for topic in selected if topic not in available]
+    conclusion = (
+        f"{name}本轮只核验了{len(selected)}项与问题直接相关的主题。"
+        "现有证据可以用于说明已披露的行情、财务或公司信息，不能把单一价格变化外推为经营结论。"
+    )
+    if focus == "position_reassessment":
+        conclusion = (
+            f"{name}的回撤需要结合最新经营、公告和风险承受能力重新核验；"
+            "回撤幅度本身不足以构成加仓依据，也不应自动推导为减仓或继续持有指令。"
+        )
+    facts = []
+    if "market" in selected:
+        facts.append(f"- 行情：{market_fact}。")
+    for topic in selected:
+        if topic == "market":
+            continue
+        state = str((statuses.get(topic) or {}).get("status") or "未取得")
+        label = str(labels.get(topic) or topic)
+        facts.append(f"- {label}：本轮证据状态为 {state}。")
+    module_lines = []
+    for topic in selected[:3]:
+        label = str(labels.get(topic) or topic)
+        state = str((statuses.get(topic) or {}).get("status") or "未取得")
+        module_lines.append(
+            f"- {label}：仅依据本轮已选主题核验，当前状态为 {state}；"
+            "缺少原始披露或时间口径一致的数据时，不扩大解释范围。"
+        )
+    gaps = []
+    if unavailable:
+        gaps.append("；".join(str(labels.get(item) or item) for item in unavailable) + "尚未取得完整可用证据")
+    if focus == "position_reassessment":
+        gaps.extend(["持有期限与资金用途", "可承受的最大回撤"])
+    if not gaps:
+        gaps.append("后续披露与本轮数据口径是否一致")
+    lines = [
+        "数据来源：确定性摘要（本轮未调用生成式模型）。",
+        "",
+        "## 综合判断",
+        conclusion,
+        "",
+        "## 关键证据",
+        *(facts[:4] or ["- 当前没有足够的结构化事实形成额外判断。"]),
+        "",
+        "## 专题核验",
+        *module_lines,
+        "",
+        "## 仍需确认",
+        *(f"- {item}。" for item in gaps[:3]),
+    ]
+    return "\n".join(lines)[:700].rstrip()
+
+
