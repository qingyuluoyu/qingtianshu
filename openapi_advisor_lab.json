                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/me/advisor-lab/context/{assistant_message_id}": {
      "get": {
        "summary": "Get Advisor Lab Context",
        "operationId": "get_advisor_lab_context_me_advisor_lab_context__assistant_message_id__get",
        "parameters": [
          {
            "name": "assistant_message_id",
            "in": "path",
