  "components": {
    "schemas": {
      "AdvisorLabChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 24
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbol"
          },
          "model_tier": {
            "type": "string",
            "enum": [
              "economy",
              "deep",
              "vision"
            ],
            "title": "Model Tier",
            "default": "economy"
          },
          "execute_agent": {
            "type": "boolean",
            "title": "Execute Agent",
            "default": true
          },
          "image_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 36
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Id"
          },
          "document_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 36
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 36
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 8
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "AdvisorLabChatRequest"
      }
    }
  }
}